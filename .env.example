VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Only used by `npm run test:voice`, the WhatsApp agent's local voice check.
# Same key generate-news-digest uses. The deployed functions read their own
# copy from Supabase secrets, so this is purely for running the check locally.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# AI Agent Mastery scholarship (the /scholarship form + discounted checkout).
# The REAL settings are Supabase Edge Function secrets — set them with
# `supabase secrets set NAME=value`; deployed functions don't read this file.
# All have defaults, so none are required:
#   SCHOLARSHIP_AUTO_APPROVE=false            # default: applications wait for you to approve them at /admin/scholarships; "true" = approve on submit
#   SCHOLARSHIP_PRICE_NAIRA=10000             # price for approved applicants (create-paystack-checkout + paystack-webhook)
#   SCHOLARSHIP_CLOSES_AT=2026-10-08T20:00:00+01:00   # form closes: Thu 8 Oct, 8 PM WAT (submit-scholarship-application)
#   SCHOLARSHIP_EXPIRES_AT=2026-10-09T19:00:00+01:00  # offer lapses at class start: Fri 9 Oct, 7 PM WAT (create-paystack-checkout)
#
# The page only mirrors these to decide what to show (the server enforces them).
# If you change a secret, set the same value here / in Vercel so the copy matches.
# Nothing sensitive goes in a VITE_ variable.
# VITE_SCHOLARSHIP_PRICE_NAIRA=10000
# VITE_SCHOLARSHIP_CLOSES_AT=2026-10-08T20:00:00+01:00
# VITE_SCHOLARSHIP_EXPIRES_AT=2026-10-09T19:00:00+01:00
